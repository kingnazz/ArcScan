{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ArcScan",
  "version": "1.4.1",
  "identifier": "com.arcscan.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "ArcScan",
        "width": 1280,
        "height": 820,
        "minWidth": 940,
        "minHeight": 620,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "ArcScan",
    "category": "Utility",
    "shortDescription": "Fast, lightweight network & port scanner",
    "longDescription": "ArcScan is a fast, lightweight network and port scanner. Discover live hosts, identify vendors and open services, browse scan history, and export results.",
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      },
      "wix": {
        "language": ["en-US"]
      },
      "nsis": {
        "installMode": "perMachine"
      }
    }
  },
  "plugins": {}
}
